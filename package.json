{
  "name": "formy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy && next start -H 0.0.0.0",
    "lint": "eslint",
    "pretest": "node scripts/setup-test-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "registry:build": "tsx --env-file=.env scripts/build-registry.ts",
    "agent": "node agent/apply.js",
    "mcp": "node mcp/server.js",
    "demo:serve": "node demo/serve.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "next": "^16.2.10",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
